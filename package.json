{
  "name": "erp-frontend",
  "private": true,
  "packageManager": "yarn@4.14.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:generate": "yarn workspace @erp/api-client generate",
    "api:snapshot": "yarn workspace @erp/api-client snapshot",
    "dev": "yarn workspace @erp/web dev",
    "build": "yarn api:generate && yarn workspace @erp/web build",
    "typecheck": "yarn workspaces foreach -A --exclude erp-frontend run typecheck",
    "lint": "yarn workspace @erp/web lint"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
